SetGridsize(512, 64, 1)
SetCellsize(2e-9, 2e-9, 0.6e-9)
Msat  = 1.1e6
Aex   = 16e-12
Ku1   = 1.25e6
AnisU = vector(0, 0, 1)
alpha = 0.3

// Spin-orbit torque from the current in the Pt layer
Lambda       = 1
EpsilonPrime = 0
Pol          = 0.1               // spin Hall angle of Pt: how efficiently Pt converts charge current to spin current
FixedLayer   = vector(0, 1, 0)   // the spins arriving from Pt point along y

L  := 1024e-9      // strip length (m)
Jc := 2e11         // current density in Pt (A/m^2)
tpulse := 1e-9     // current is on for 1 ns
x1 := 0.0
x2 := 0.0

// ---- Case 1: Neel wall, D = +1 ----
Dind = 1e-3
J = vector(0, 0, 0)
m = TwoDomain(0,0,1,  -1,0,0,  0,0,-1)
relax()
x1 = L*(1 + m.comp(2).average())/2
J = vector(0, 0, Jc)
run(tpulse)
x2 = L*(1 + m.comp(2).average())/2
print("Case 1 Neel D=+1 : moved", (x2-x1)*1e9, "nm  speed", (x2-x1)/T, "m/s")

// ---- Case 2: Neel wall, opposite chirality, D = -1 ----
Dind = -1e-3
J = vector(0, 0, 0)
m = TwoDomain(0,0,1,  1,0,0,  0,0,-1)
relax()
x1 = L*(1 + m.comp(2).average())/2
J = vector(0, 0, Jc)
run(tpulse)
x2 = L*(1 + m.comp(2).average())/2
print("Case 2 Neel D=-1 : moved", (x2-x1)*1e9, "nm  speed", (x2-x1)/T, "m/s")

// ---- Case 3: Bloch wall, D = 0 ----
Dind = 0
J = vector(0, 0, 0)
m = TwoDomain(0,0,1,  0,1,0,  0,0,-1)
relax()
x1 = L*(1 + m.comp(2).average())/2
J = vector(0, 0, Jc)
run(tpulse)
x2 = L*(1 + m.comp(2).average())/2
print("Case 3 Bloch D=0 : moved", (x2-x1)*1e9, "nm  speed", (x2-x1)/T, "m/s")