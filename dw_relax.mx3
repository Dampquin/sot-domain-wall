SetGridsize(512, 64, 1)
SetCellsize(2e-9, 2e-9, 0.6e-9)

Msat  = 1.1e6
Aex   = 16e-12
Ku1   = 1.25e6
AnisU = vector(0, 0, 1)
alpha = 0.3

// Run 1: no DMI -> expect Bloch wall
Dind = 0
m = TwoDomain(0,0,1,  0,1,0,  0,0,-1)
relax()
save(m)

// Run 2: interfacial DMI -> expect Neel wall
Dind = 1e-3
m = TwoDomain(0,0,1,  -1,0,0,  0,0,-1)
relax()
save(m)